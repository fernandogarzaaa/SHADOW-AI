SHADOW_NODE_HOST=127.0.0.1
SHADOW_NODE_PORT=8787

# --- Privacy / transport ---
SHADOW_PRIVACY_MODE=strict_local
# Require signed, replay-protected requests on all protected routes (production: true).
SHADOW_AUTH_REQUIRED=false

# --- Persistent encrypted memory ---
# When set, memory persists across restarts using a stable key (below).
SHADOW_MEMORY_DB=./data/shadow_memory.db
# Provide a key directly (urlsafe base64 Fernet key) OR point to a key file.
# If neither is set, a key file is generated at data/keys/memory.key (0600).
SHADOW_MEMORY_KEY=
SHADOW_MEMORY_KEY_FILE=./data/keys/memory.key

# --- Model providers ---
# Default is fully offline. Set provider=anthropic + a key to enable real cloud answers.
SHADOW_CLOUD_ENABLED=false
SHADOW_MODEL_PROVIDER=local_mock
SHADOW_MODEL_NAME=claude-sonnet-4-6
SHADOW_MODEL_ENDPOINT=
# Name of the env var that holds the API key (defaults to ANTHROPIC_API_KEY).
SHADOW_MODEL_API_KEY_ENV=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# --- Action / context runtimes ---
GHOST_RUNTIME_MODE=mock
AXIOM_RUNTIME_MODE=deterministic
